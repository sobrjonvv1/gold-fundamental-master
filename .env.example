APP_ENV=production
DEBUG=false
PROJECT_NAME="GOLD FUNDAMENTAL MASTER"
SECRET_KEY=change_this_to_a_secure_random_secret_key_32_bytes

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/gold_fundamental

# Redis Cache & Queue
REDIS_URL=redis://redis:6379/0

# Telegram Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBAPP_URL=https://your-domain.com

# OpenRouter AI Settings
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_DAILY_REQUEST_LIMIT=100

# External Data Providers (Optional / Abstracted)
FOREX_FACTORY_PROVIDER=mock
FOREX_FACTORY_API_KEY=

FED_PROVIDER=mock
FED_API_KEY=

MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

NEWS_PROVIDER=mock
NEWS_API_KEY=

# Session UTC Open Times (Format HH:MM)
SESSION_ASIA_OPEN=00:00
SESSION_LONDON_OPEN=08:00
SESSION_NEW_YORK_OPEN=13:00

DEFAULT_TIMEZONE=UTC

# Mock Mode (Set to true to run fully offline without live external APIs)
MOCK_MODE=true
